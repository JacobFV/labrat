# LabRat server config. Every integration is optional; missing keys degrade gracefully.
LABRAT_TOKEN=labrat
LABRAT_AUTO_APPROVE=0
# The iPhone is on a static stand, so photos move no arm. Only if you mount the phone on an arm: [device:]pose, e.g. so_a:look_plate
LABRAT_PHOTO_POSE=
# Seconds the photo step waits for a fresh phone frame
LABRAT_PHOTO_WAIT_S=3

# LLM: anthropic (default) or fireworks. No key -> rule-based agent.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed for API keys not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic

# MongoDB Atlas (experiments, variants, runs, memories, events, sim_params, observations; vector index on memories.embedding)
MONGODB_URI=
MONGODB_DB=labrat
# Voyage AI embeddings (voyage-3.5)
VOYAGE_API_KEY=
# Key from dash.voyageai.com: keep the default URL. A "Model API key" from MongoDB Atlas (AI Models page): use https://ai.mongodb.com/v1
VOYAGE_BASE_URL=https://api.voyageai.com/v1
# Raindrop AI observability
RAINDROP_API_KEY=
# ElevenLabs TTS/STT
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Modelence session/event hook (generic JSON POST)
MODELENCE_URL=
MODELENCE_KEY=
